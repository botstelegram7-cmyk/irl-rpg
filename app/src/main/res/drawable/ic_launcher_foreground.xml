<?xml version="1.0" encoding="utf-8"?>
<!-- Clay "level up" emblem: three rising pastel capsules under a floating orb. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- left capsule -->
    <path android:pathData="M30,68 A6,6 0 0 1 42,68 L42,72 A6,6 0 0 1 30,72 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="30"
                android:startY="62"
                android:endX="42"
                android:endY="78">
                <item android:offset="0" android:color="#FFC7B6F5" />
                <item android:offset="1" android:color="#FFA78BFA" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- middle capsule -->
    <path android:pathData="M48,58 A6,6 0 0 1 60,58 L60,72 A6,6 0 0 1 48,72 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="48"
                android:startY="52"
                android:endX="60"
                android:endY="78">
                <item android:offset="0" android:color="#FFA6DAF7" />
                <item android:offset="1" android:color="#FF6FB6F0" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- right capsule -->
    <path android:pathData="M66,48 A6,6 0 0 1 78,48 L78,72 A6,6 0 0 1 66,72 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="66"
                android:startY="42"
                android:endX="78"
                android:endY="78">
                <item android:offset="0" android:color="#FFA8EBD6" />
                <item android:offset="1" android:color="#FF55D2AC" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- baseline glow under the capsules -->
    <path android:pathData="M28,80 A26,5 0 0 0 80,80 A26,5 0 0 0 28,80 Z"
        android:fillColor="#228E82AA" />

    <!-- floating reward orb -->
    <path android:pathData="M46,32 a8,8 0 1 0 16,0 a8,8 0 1 0 -16,0 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="radial"
                android:centerX="51"
                android:centerY="27"
                android:gradientRadius="16">
                <item android:offset="0" android:color="#FFFFE0CB" />
                <item android:offset="1" android:color="#FFF7A97F" />
            </gradient>
        </aapt:attr>
    </path>
    <path android:pathData="M49.5,29.5 a2.8,2.8 0 1 0 5.6,0 a2.8,2.8 0 1 0 -5.6,0 Z"
        android:fillColor="#CCFFFFFF" />
</vector>
